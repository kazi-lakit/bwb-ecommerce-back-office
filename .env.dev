# Blocks OIDC login config for the "bwb" project — deployed ("dev"
# environment) build of ecommerce. Same project/tenant/OIDC client as local
# dev (see .env.local / .env.example), just a different app domain.
#
# Consumed by set-env.cjs (via `npm run build:dev`), which copies this file
# to .env before `vite build` runs. Values are not secret (a public PKCE
# client needs no client_secret); tracked in git so a fresh CI checkout can
# run the Docker build.
#
# Points at the "blocks-shop" project (D9d1f667bf6a940828c66e196544e536a).
# dwyxlp-ekqyt.slsblx.com is this project's actual provisioned application
# domain (per `blocks projects list`) and is already registered as a redirect
# URI on the OIDC client below — no placeholder swap needed for this domain.
#
# If the deployed domain ever changes, register the new
# https://<domain>/login/callback as a redirect URI on the OIDC client
# (`blocks auth oidc-clients save --item-id <id> --redirect-uris "<full list
# incl. the new one>"` — it replaces the whole list, so include every URI
# still needed, not just the new one).

VITE_BLOCKS_API_URL=https://blocksapi.slsblx.com
VITE_BLOCKS_PROJECT_KEY=D9d1f667bf6a940828c66e196544e536a
VITE_BLOCKS_APP_DOMAIN=https://dwyxlp-ekqyt.slsblx.com
VITE_BLOCKS_OIDC_CLIENT_ID=8853368a-8958-4b4c-a33e-9ef4680a2d81
VITE_BLOCKS_OIDC_URL=https://iam.seliseblocks.com
VITE_BLOCKS_OIDC_SCOPE=openid profile
VITE_STOREFRONT_CONTENT_LIVE=true

# No VITE_BLOCKS_DEV_HOST/PORT here — those only affect vite.config.ts's
# local dev-server block, which doesn't run during `vite build`.
