{
  "schemaName": "PurchaseOrder",
  "schemaType": 1,
  "fields": [
    {
      "name": "PurchaseOrderNumber",
      "type": "String",
      "description": "Organization-unique purchase order number.",
      "isUniqueData": true
    },
    {
      "name": "SupplierId",
      "type": "String",
      "description": "Supplier identifier."
    },
    {
      "name": "WarehouseId",
      "type": "String",
      "description": "Receiving warehouse identifier."
    },
    {
      "name": "Status",
      "type": "String",
      "description": "draft, submitted, approved, partially_received, received, cancelled, or closed."
    },
    {
      "name": "OrderDate",
      "type": "DateTime",
      "description": "Date placed with the supplier."
    },
    {
      "name": "ExpectedDeliveryDate",
      "type": "DateTime",
      "description": "Expected receipt date."
    },
    {
      "name": "Currency",
      "type": "String",
      "description": "ISO 4217 currency code."
    },
    {
      "name": "Items",
