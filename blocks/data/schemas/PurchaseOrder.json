      "description": "Sum before tax and shipping."
    },
    {
      "name": "TaxAmount",
      "type": "Float",
      "description": "Total tax."
    },
    {
      "name": "ShippingAmount",
      "type": "Float",
      "description": "Shipping and handling charges."
    },
    {
      "name": "GrandTotal",
      "type": "Float",
      "description": "Final payable amount."
    },
    {
      "name": "Notes",
      "type": "String",
      "description": "Buyer or receiving notes."
    },
    {
      "name": "ApprovedBy",
      "type": "String",
      "description": "Approver user identifier."
    },
    {
      "name": "ApprovedDate",
      "type": "DateTime",
      "description": "Approval timestamp."
    }
